{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://berrystudio.app/schema/pattern-spec.v1.json",
  "title": "BerryStudio Pattern Spec v1",
  "description": "A declarative garment description for FUTURE AI-generated patterns (BerryStudio-Upgrade-Plan WP-0.3/WP-1/WP-3). An LLM asked to emit raw polygon coordinates produces geometrically invalid, ungradable output; an LLM asked to emit a spec matching this schema produces reliable output that BerryStudio's existing deterministic engine (AIGen.build(), the grading engine, the associative construction solver) can turn into correct, gradable geometry. Nothing in the app emits or consumes this spec yet — this is the schema and its validator only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "garment", "pieces"],
  "properties": {
    "specVersion": { "const": "1" },

    "garment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "category"],
      "properties": {
        "type": { "enum": ["dress", "top", "shirt", "skirt", "trousers", "robe", "romper"] },
        "category": { "enum": ["women", "men", "girls", "boys"] },
        "closure": { "enum": ["none", "button", "zip", "wrap", "tie"] },
        "referenceMeasurementsCm": {
          "description": "The body measurements a REFERENCE tech-pack/spec-sheet image was itself drafted for (its own printed 'Body Measurements' table), if the source image is that kind of technical flat-sketch rather than a worn-garment photo. Lets pieces[].outlineCm be scaled from this reference body to the wearer's own measurements instead of only ever fitting the reference size verbatim. Omit entirely for a photo/text-only generation with no printed measurement table to read.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chest": { "type": "number", "minimum": 20, "maximum": 200 },
            "waist": { "type": "number", "minimum": 20, "maximum": 200 },
            "hips": { "type": "number", "minimum": 20, "maximum": 200 },
            "backLen": { "type": "number", "minimum": 5, "maximum": 120 },
            "shoulder": { "type": "number", "minimum": 5, "maximum": 60 },
            "sleeve": { "type": "number", "minimum": 5, "maximum": 100 },
            "neck": { "type": "number", "minimum": 5, "maximum": 80 },
            "bicep": { "type": "number", "minimum": 5, "maximum": 80 },
            "inseam": { "type": "number", "minimum": 5, "maximum": 120 },
            "thigh": { "type": "number", "minimum": 5, "maximum": 100 },
            "height": { "type": "number", "minimum": 30, "maximum": 220 }
          }
        }
      }
    },

    "silhouette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lengthF": { "type": "number", "minimum": 0, "maximum": 3 },
        "flareF": { "type": "number", "minimum": 0, "maximum": 3 },
        "fitF": { "type": "number", "minimum": 0, "maximum": 3 }
      }
    },

    "construction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "neckline": { "enum": ["v", "round", "boat", "off-shoulder", "halter", "collar", "mock"] },
        "necklineDepthF": { "type": "number", "minimum": 0, "maximum": 2 },
        "sleeve": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["none", "set-in", "raglan", "two-piece"] },
            "lengthF": { "type": "number", "minimum": 0, "maximum": 3 },
            "widthF": { "type": "number", "minimum": 0, "maximum": 3 }
          }
        },
        "hem": { "enum": ["straight", "curved", "highlow", "asymmetric"] },
        "seams": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "pieces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "cutOnFold", "quantity", "grainline"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "label": {
            "description": "A garment-specific display name for this piece (e.g. 'Front Placket', 'Drawstring Tunnel') — `role` alone is a generic placement category, not a name a person drafting from a real reference sheet would recognize. Optional; falls back to a role-derived name when absent.",
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "ar"],
            "properties": { "en": { "type": "string" }, "ar": { "type": "string" } }
          },
          "outlineCm": {
            "description": "The piece's ACTUAL traced outline in centimeters — [x,y] corners in drafting order, read directly off a technical flat-sketch/tech-pack image's own piece diagram and printed dimensions (not a relative style factor). Only meaningful when the source image is that kind of technical drawing with real labeled measurements; omit for a photo or text-only generation, where the relative silhouette/construction factors above are what drive AIGen.build() instead. When present alongside garment.referenceMeasurementsCm, coordinates are scaled to the wearer's own measurements before use; without it, they're used exactly as given (fits only the reference size).",
            "type": "array",
            "minItems": 3,
            "maxItems": 60,
            "items": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": { "type": "number", "minimum": -50, "maximum": 300 }
            }
          },
          "role": {
            "description": "bodice-front/bodice-back/skirt-front/skirt-back are kept as validator-resolved aliases for the WP-6 vocabulary below (front-panel/back-panel/hip-panel-front/hip-panel-back in cloth-lab's own placement roles — see cloth-lab/src/pattern/roles.js) so existing Phase-1 AI-pipeline specs keep validating unchanged.",
            "enum": [
              "bodice-front", "bodice-back", "skirt-front", "skirt-back",
              "front-panel", "back-panel", "shorts-front", "shorts-back",
              "bodice-front-center", "bodice-front-side", "bodice-back-center", "bodice-back-side",
              "skirt-front-gore", "skirt-back-gore", "skirt-side-gore-left", "skirt-side-gore-right",
              "sleeve", "sleeve-upper", "sleeve-under", "cap-sleeve", "puff-sleeve", "butterfly-sleeve",
              "collar", "undercollar", "collar-stand", "collar-band",
              "lapel-facing", "placket-facing", "facing",
              "hood", "yoke", "epaulette", "peplum-front", "peplum-back",
              "sash", "wrap-tie", "belt", "pocket",
              "waistband", "cuff", "rib-cuff", "hem-band",
              "lining", "godet", "tier", "cape", "cape-overlay",
              "cup", "band", "strap", "elastic-band", "gusset",
              "other"
            ]
          },
          "cutOnFold": { "type": "boolean" },
          "quantity": { "type": "integer", "minimum": 1 },
          "grainline": { "enum": ["straight", "cross", "bias"] },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "seamId": { "type": ["string", "null"] },
                "seamAllowanceMm": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },

    "seams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "a", "b"],
        "properties": {
          "id": { "type": "string" },
          "a": { "type": "string", "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$" },
          "b": { "type": "string", "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$" }
        }
      }
    },

    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "source"],
        "properties": {
          "field": { "type": "string" },
          "source": { "enum": ["user", "llm-inferred", "default"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
